{
  "manifest_version": 3,
  "name": "Gmail Flow",
  "description": "Email that works with your brain. Fast, calm, and neurodivergent-friendly Gmail.",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://mail.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["src/styles.css"],
      "js": [
        "src/utils.js",
        "src/helpers.js",
        "src/features/cleanup.js",
        "src/features/focus.js",
        "src/features/highlighting.js",
        "src/features/time-awareness.js",
        "src/features/priority.js",
        "src/features/shortcuts.js",
        "src/features/typography.js",
        "src/features/background-tints.js",
        "src/features/dom-surgery.js",
        "src/features/reading-mode.js",
        "src/ui-panel.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Gmail Flow",
    "default_popup": "popup/popup.html"
  }
}
